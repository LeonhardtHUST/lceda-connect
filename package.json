{
  "name": "lceda-connect",
  "version": "0.1.0",
  "description": "嘉立创EDA专业版 (EasyEDA Pro) 一体化工具箱：MCP 服务 + CLI，覆盖 CDP/AI Bridge 连接、工程文件解析、格式校验、API 文档检索与 ngspice 仿真。",
  "keywords": [
    "ai-bridge",
    "cdp",
    "chrome-devtools-protocol",
    "cli",
    "easyeda",
    "easyeda-pro",
    "lceda",
    "mcp"
  ],
  "license": "GPL-3.0-only",
  "author": "Leon",
  "bin": {
    "lceda-bridge": "./dist/cli-bridge.mjs",
    "lceda-cdp": "./dist/cli-cdp.mjs",
    "lceda-connect": "./dist/cli.mjs",
    "lceda-mcp": "./dist/cli-mcp.mjs"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CREDITS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./cli-bridge": "./dist/cli-bridge.mjs",
    "./cli-bridge-server": "./dist/cli-bridge-server.mjs",
    "./cli-cdp": "./dist/cli-cdp.mjs",
    "./cli-mcp": "./dist/cli-mcp.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config --no-agent",
    "hooks:install": "vp hooks enable",
    "hooks:uninstall": "vp hooks disable",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
