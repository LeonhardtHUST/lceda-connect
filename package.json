{
  "name": "lceda-connect",
  "version": "0.3.0",
  "description": "嘉立创EDA专业版 (EasyEDA Pro) 一体化工具箱：MCP 服务 + CLI，覆盖 CDP/AI Bridge 连接、工程文件解析、格式校验、API 文档检索与 ngspice 仿真。",
  "keywords": [
    "ai-bridge",
    "cdp",
    "chrome-devtools-protocol",
    "cli",
    "easyeda",
    "easyeda-pro",
    "lceda",
    "mcp"
  ],
  "homepage": "https://github.com/LeonhardtHUST/lceda-connect#readme",
  "bugs": {
    "url": "https://github.com/LeonhardtHUST/lceda-connect/issues"
  },
  "license": "GPL-3.0-only",
  "author": "Leon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonhardtHUST/lceda-connect.git"
  },
  "bin": {
    "lceda-bridge": "./dist/cli-bridge.mjs",
    "lceda-cdp": "./dist/cli-cdp.mjs",
    "lceda-connect": "./dist/cli.mjs",
    "lceda-mcp": "./dist/cli-mcp.mjs"
  },
  "files": [
    "dist",
    "assets/README.md",
    "assets/format",
    "assets/sidecar",
    "assets/skills/cdp-connect",
    "assets/skills/easyeda-connect",
    "assets/skills/easyeda-format",
    "assets/skills/eprj3",
    "assets/skills/ngspice-sim",
    "assets/skills/project-analysis",
    "README.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/cdp-input.md",
    "docs/merge-plan.md",
    "docs/extensions.md",
    "docs/publishing.md",
    "docs/quickstart.md",
    "docs/environments.md",
    "docs/transports.md",
    "docs/architecture.md"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cli": "./dist/cli.mjs",
    "./cli-bridge": "./dist/cli-bridge.mjs",
    "./cli-bridge-server": "./dist/cli-bridge-server.mjs",
    "./cli-cdp": "./dist/cli-cdp.mjs",
    "./cli-mcp": "./dist/cli-mcp.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "ci": "vp check && vp test && vp pack",
    "prepublishOnly": "vp check && vp test && vp run build",
    "prepare": "vp config --no-agent",
    "hooks:install": "vp hooks enable",
    "hooks:uninstall": "vp hooks disable",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@12.21.0"
}
