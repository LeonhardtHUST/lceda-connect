{
  "schema_version": "1",
  "pack_id": "pcb-layout",
  "delivery": {
    "max_rules_per_stage": 7,
    "rationale": "FollowBench(ACL24)：约束条数上升时满足率单调下降，GPT-4 CSL≈3.3；故每阶段硬上限 7，超了必须拆阶段而不是压缩描述。",
    "reanchor": "每阶段入口重新投递该阶段子集（Lost-in-Multi-Turn：多轮 -39%，早轮假设不自纠）。"
  },
  "stages": [
    {
      "stage": "board_setup",
      "label": "P0 板级设定",
      "rules": [],
      "requires_decisions": [
        "D-STACKUP",
        "D-PROCESS",
        "D-IMPEDANCE"
      ],
      "why": "本阶段无已编译规则。先把叠层/工艺/阻抗答了——它们是后续规则 applicability 的前提；未答则相关规则一律 unverified（不是 pass）。"
    },
    {
      "stage": "placement",
      "label": "P1 布局",
      "rules": [],
      "requires_decisions": [
        "D-GROUND",
        "D-ZONE",
        "D-INTERFACES"
      ],
      "why": "分区/接地/接口是设计决策，不是检查项。§4/§11 属 T3，机器不判；但 D-ZONE 的答案决定 P2b 密集区间距规则是否可判。"
    },
    {
      "stage": "routing_width",
      "label": "P2a 布线·线宽",
      "rules": [
        "R6.1-GPIO-W",
        "R6.1-LOWCTRL-W",
        "R6.1-ESC-W",
        "R6.1-CLK-W",
        "R6.1-PWR-LOW-W",
        "R6.1-PWR-MAIN-W"
      ],
      "requires_decisions": [
        "D-PROCESS"
      ],
      "why": "三条信号档同一阈值 0.20；电源两档要校核载流。板厂最小线宽未答时，逃逸档（0.15）是否可行无法判定。"
    },
    {
      "stage": "routing_clearance",
      "label": "P2b 布线·间距",
      "rules": [
        "R6.2-SIG-SIG-C",
        "R6.2-DENSE-C",
        "R6.2-PWR-SIG-C",
        "R6.2-PWR-PWR-C"
      ],
      "requires_decisions": [
        "D-ZONE"
      ],
      "why": "通用下限 0.20；密集区 0.15。板上没声明 dense_routing 时，密集区规则 unverified，且低于 0.20 但仍 ≥0.15 的配对会进 `would_pass_if_dense`（假阳性候选）。"
    },
    {
      "stage": "routing_via",
      "label": "P2c 布线·过孔",
      "rules": [
        "R7.3-VIA-STD",
        "R7.3-VIA-COMPACT",
        "R7.3-VIA-PWR"
      ],
      "requires_decisions": [
        "D-PROCESS"
      ],
      "why": "三档只做归类与覆盖率，永不 fail；unclassified>0 ⇒ 整包至少 unverified。"
    },
    {
      "stage": "signoff",
      "label": "P5 签核",
      "rules": [],
      "requires_decisions": [],
      "why": "§9 地平面 / §11 分区 / §12 EMI / §15 美学属 T3：机器不判，只出图 + 人工清单。签核报告从 compliance.jsonl 生成，不是再读一遍文档写感想。"
    }
  ],
